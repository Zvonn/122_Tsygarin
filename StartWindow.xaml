<Window x:Class="_122_Tsygarin.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_122_Tsygarin"
        xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource ExtraBrush2}">
            <Button x:Name="BackButton"
                    Content="Назад"
                    Width="80"
                    Height="30"
                    Margin="10,7,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BackButton_Click"
                    />

            <ComboBox x:Name="ThemeSelector"
                      Width="150"
                      Height="30"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,7,10,0"
                      SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Светлая тема" IsSelected="True"/>
                <ComboBoxItem Content="Тёмная тема"/>
            </ComboBox>
        </Grid>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource ExtraBrush1}"/>

        <Grid Grid.Row="2" Background="{DynamicResource ExtraBrush2}">
            <TextBlock x:Name="DateTimeNow"
            HorizontalAlignment="Left"
            Margin="522,0,0,0"
            VerticalAlignment="Center"
            Height="35"
            Width="194"
            Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>

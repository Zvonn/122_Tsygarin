<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Color x:Key="MainColor1">#FF6B8A81</Color>
    <Color x:Key="MainColor2">#FF875F64</Color>

    <Color x:Key="ExtraColor1">#FF36454F</Color>
    <Color x:Key="ExtraColor2">#FF4A5C66</Color>

    <Color x:Key="TextColorWhite">#FFFFFFFF</Color>
    <Color x:Key="TextColorGray">#FFDDDDDD</Color>

    <SolidColorBrush x:Key="MainBrush1" Color="{StaticResource MainColor1}"/>
    <SolidColorBrush x:Key="MainBrush2" Color="{StaticResource MainColor2}"/>
    <SolidColorBrush x:Key="ExtraBrush1" Color="{StaticResource ExtraColor1}"/>
    <SolidColorBrush x:Key="ExtraBrush2" Color="{StaticResource ExtraColor2}"/>
    <SolidColorBrush x:Key="WhiteTextBrush" Color="{StaticResource TextColorWhite}"/>
    <SolidColorBrush x:Key="GrayTextBrush" Color="{StaticResource TextColorGray}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ExtraBrush1}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource MainBrush1}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MainBrush2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource ExtraBrush2}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainBrush1}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

</ResourceDictionary>

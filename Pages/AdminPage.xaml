<Page x:Class="_122_Tsygarin.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администраторская панель">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Первая строка кнопок -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <Button x:Name="BtnTab1" Content="Таблица пользователей"
                        Width="180" Click="BtnTab1_Click"/>

                <Button x:Name="BtnTab2" Content="Таблица категорий"
                        Width="180" Click="BtnTab2_Click"/>

                <Button x:Name="BtnTab3" Content="Таблица платежей"
                        Width="180" Click="BtnTab3_Click"/>
            </StackPanel>

            <!-- Кнопка диаграммы -->
            <Button x:Name="BtnTab4" Content="Диаграммы"
                    Width="150" HorizontalAlignment="Center"
                    Click="BtnTab4_Click"/>
        </StackPanel>
    </Grid>
</Page>
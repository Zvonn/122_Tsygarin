<Page x:Class="_122_Tsygarin.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_122_Tsygarin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid HorizontalAlignment="Center"
          Width="800"
          Height="450"
          VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="271*" />
            <ColumnDefinition Width="529*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="217*" />
            <RowDefinition Height="233*" />
        </Grid.RowDefinitions>

        <!-- Левая часть с метками -->
        <Label Content="Логин"
               x:Name="labelLogin"
               Margin="80,63,0,12"
               HorizontalAlignment="Left"
               Width="100"
               Grid.RowSpan="1" />

        <Label Content="Пароль"
               x:Name="labelPass"
               Margin="80,104,0,16"
               HorizontalAlignment="Left"
               Width="100"
               Grid.RowSpan="1" />

        <!-- Поле логина -->
        <TextBox x:Name="TextBoxLogin"
                 Margin="62,60,0,0"
                 TextWrapping="Wrap"
                 ToolTip="Введите логин или почту"
                 Height="34"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"
                 Width="180"
                 Grid.Column="1"
                 Grid.Row="0"
                 TextChanged="TextBoxLogin_TextChanged" />

        <Label x:Name="lblLoginHitn"
               Foreground="Gray"
               Content="Введите логин"
               Grid.Column="1"
               Grid.Row="0"
               HorizontalAlignment="Left"
               Margin="62,60,0,0"
               VerticalAlignment="Top"
               Width="180"
               Height="34"
               MouseLeftButtonUp="lblLoginHitn_MouseLeftButtonUp" />

        <!-- Поле пароля -->
        <PasswordBox x:Name="PasswordBox"
                     ToolTip="Введите пароль"
                     Margin="62,105,0,0"
                     HorizontalAlignment="Left"
                     Width="180"
                     Height="34"
                     VerticalAlignment="Top"
                     Grid.Column="1"
                     Grid.Row="0"
                     PasswordChanged="PasswordBox_PasswordChanged" />

        <Label x:Name="lblPassHitn"
               Foreground="Gray"
               Content="Введите пароль"
               Grid.Column="1"
               Grid.Row="0"
               HorizontalAlignment="Left"
               Margin="62,105,0,0"
               VerticalAlignment="Top"
               Width="180"
               Height="34"
               MouseLeftButtonUp="lblPassHitn_MouseLeftButtonUp" />

        <!-- Кнопки в нижней части -->
        <Button x:Name="ButtonEnter"
                Margin="69,20,0,0"
                Height="34"
                Content="Вход"
                ToolTip="Кнопка входа"
                Grid.Row="1"
                HorizontalAlignment="Left"
                Width="120"
                VerticalAlignment="Top"
                Grid.Column="1"
                Click="ButtonEnter_OnClick" />

        <Button x:Name="ButtonReg"
                Margin="69,68,0,0"
                Height="37"
                Content="Регистрация"
                ToolTip="Кнопка регистрации"
                Grid.Row="1"
                HorizontalAlignment="Left"
                Width="120"
                VerticalAlignment="Top"
                Grid.Column="1"
                Click="ButtonReg_Click" />

        <Button x:Name="ButtonChangePassword"
                Margin="69,120,0,0"
                Height="37"
                Content="Смена пароля"
                ToolTip="Кнопка смены пароля"
                Grid.Row="1"
                HorizontalAlignment="Left"
                Width="120"
                VerticalAlignment="Top"
                Grid.Column="1"
                Click="ButtonChangePassword_Click" />

        <!-- Капча (скрыта по умолчанию) -->
        <Label Content="Капча:"
               x:Name="labelCaptcha"
               Visibility="Hidden"
               Margin="80,75,0,0"
               HorizontalAlignment="Left"
               Width="100"
               Grid.RowSpan="1" />

        <TextBox Grid.Column="1"
                 Grid.Row="0"
                 CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                 ContextMenu="{x:Null}"
                 Visibility="Hidden"
                 x:Name="captcha"
                 Height="42"
                 Foreground="Red"
                 FontStyle="Italic"
                 FontWeight="Heavy"
                 VerticalAlignment="Top"
                 Width="180"
                 Background="White"
                 FontStretch="UltraCondensed"
                 IsReadOnly="True"
                 HorizontalContentAlignment="Center"
                 HorizontalAlignment="Left"
                 Margin="62,60,0,0"
                 VerticalContentAlignment="Center"
                 FontSize="20" />

        <TextBox Grid.Column="1"
                 Grid.Row="0"
                 Visibility="Hidden"
                 x:Name="captchaInput"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="62,105,0,0"
                 TextWrapping="Wrap"
                 Text=""
                 VerticalAlignment="Top"
                 Width="180"
                 ToolTip="Введите капчу" />

        <Button x:Name="submitCaptcha"
                Margin="69,20,0,0"
                Visibility="Hidden"
                Height="34"
                Content="Подтвердить"
                ToolTip="Подтвердить ввод капчи"
                Grid.Row="1"
                HorizontalAlignment="Left"
                Width="120"
                VerticalAlignment="Top"
                Grid.Column="1"
                Click="submitCaptcha_Click" />
    </Grid>
</Page>
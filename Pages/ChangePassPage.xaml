<Page x:Class="_122_Tsygarin.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    

    <Grid Background="{StaticResource ExtraBrush1}">
        <Border Background="{StaticResource MainBrush2}" 
                CornerRadius="10" 
                Padding="30"
                MaxWidth="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Смена пароля" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BlackTextBrush}"
                           Margin="0,0,0,0"/>

                <!-- Логин -->
                <Label Content="Логин:" Foreground="{StaticResource BlackTextBrush}"/>
                <TextBox x:Name="TbLogin" Width="300"/>

                <!-- Текущий пароль -->
                <Label Content="Текущий пароль:" Foreground="{StaticResource BlackTextBrush}"/>
                <PasswordBox x:Name="CurrentPasswordBox" Width="300"/>

                <!-- Новый пароль -->
                <Label Content="Новый пароль:" Foreground="{StaticResource BlackTextBrush}"/>
                <PasswordBox x:Name="NewPasswordBox" Width="300"/>

                <!-- Подтверждение нового пароля -->
                <Label Content="Подтвердите новый пароль:" Foreground="{StaticResource BlackTextBrush}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Width="300"/>

                <!-- Требования к паролю -->

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Сохранить" 
                            Width="120"
                            Click="SaveButton_Click"/>

                    <Button Content="Отмена" 
                            Width="120"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
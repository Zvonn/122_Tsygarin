<Page x:Class="_122_Tsygarin.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="Введите ФИО для поиска:" 
                       FontSize="13" VerticalAlignment="Center" Margin="5"/>

            <TextBox x:Name="fioFilterTextBox" MinWidth="150" 
                     TextChanged="fioFilterTextBox_TextChanged"/>

            <TextBlock Text="Сортировка по ФИО:" 
                       Margin="15,5,0,5" FontSize="13" VerticalAlignment="Center"/>

            <ComboBox x:Name="sortComboBox" 
                      SelectionChanged="sortComboBox_SelectionChanged"
                      Margin="10,7,0,0" SelectedIndex="0"
                      VerticalContentAlignment="Center" VerticalAlignment="Center"
                      Width="120" Height="35">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="onlyAdminCheckBox" 
                      Content="Только администраторы"
                      IsChecked="False" 
                      Checked="onlyAdminCheckBox_Checked"
                      Unchecked="onlyAdminCheckBox_Unchecked"
                      VerticalContentAlignment="Center" Margin="15,7,0,0"
                      FontSize="12"/>

            <Button x:Name="clearFiltersButton" Content="Очистить фильтр"
                    Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1"
                  HorizontalContentAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10" Background="{StaticResource ExtraBrush2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding FIO}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Width="200" HorizontalAlignment="Center"
                                   FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{StaticResource BlackTextBrush}"
                                   Padding="5"/>

                        <Image Grid.Row="1" Width="200" Height="200"
                               Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="Photo">
                                    <Binding.TargetNullValue>
                                        <ImageSource>images/images.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Grid.Row="2" Text="{Binding Role}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Width="200" HorizontalAlignment="Center"
                                   FontSize="12" Padding="5"
                                   Foreground="{StaticResource BlackTextBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
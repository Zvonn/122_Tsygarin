<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   
    <Color x:Key="MainColor1">#FFB5D5CA</Color>
   
    <Color x:Key="MainColor2">#FFE0A9AF</Color>

    <Color x:Key="ExtraColor1">#FFD1EEFC</Color>
    <Color x:Key="ExtraColor2">#FFFFF2D6</Color>

    <Color x:Key="TextColorBlack">#FF000000</Color>
    <Color x:Key="TextColorWhite">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="MainBrush1" Color="{StaticResource MainColor1}"/>
    <SolidColorBrush x:Key="MainBrush2" Color="{StaticResource MainColor2}"/>
    <SolidColorBrush x:Key="ExtraBrush1" Color="{StaticResource ExtraColor1}"/>
    <SolidColorBrush x:Key="ExtraBrush2" Color="{StaticResource ExtraColor2}"/>
    <SolidColorBrush x:Key="BlackTextBrush" Color="{StaticResource TextColorBlack}"/>
    <SolidColorBrush x:Key="WhiteTextBrush" Color="{StaticResource TextColorWhite}"/>

    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="10,7,0,0"/>
        
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource MainBrush1}"/>
        <Setter Property="Foreground" Value="{StaticResource BlackTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MainBrush2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ExtraBrush1}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource ExtraBrush2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainBrush1}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource ExtraBrush2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainBrush1}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BlackTextBrush}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

</ResourceDictionary>
